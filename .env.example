# --- Database (docker compose publishes Postgres on 5544) ---
POSTGRES_USER=bcai
POSTGRES_PASSWORD=bcai_dev_only
POSTGRES_DB=bankdata
DB_PORT=5544
# Owner/admin URL: schema creation and seeding only. The agent never uses it.
ADMIN_DATABASE_URL=postgresql://bcai:bcai_dev_only@localhost:5544/bankdata
# Read-only role the data agent runs as
AGENT_RO_PASSWORD=agent_ro_dev_only
AGENT_DATABASE_URL=postgresql://agent_ro:agent_ro_dev_only@localhost:5544/bankdata
# Gateway/agent process: read staff users, append audit rows (nothing else)
GATEWAY_RW_PASSWORD=gateway_rw_dev_only
GATEWAY_DATABASE_URL=postgresql://gateway_rw:gateway_rw_dev_only@localhost:5544/bankdata
# EXPLAIN total-cost ceiling for any query the agent runs
SQL_COST_CEILING=500000

# --- Seeder ---
SEED=42
# Anchor date for "24 months back" (YYYY-MM-DD); empty = today in BANK_TZ
SEED_DATE=
BANK_TZ=Asia/Kuwait

# --- LLM (phase 3) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
# qwen3:8b with an 8k context window (make ollama-model)
OLLAMA_MODEL=bcai-qwen3-8b
# qwen3 "thinks" by default: ~30 s per planner call vs ~7 s with it off (M4, 16 GB)
OLLAMA_THINK=false
OLLAMA_TIMEOUT_S=120
# Few-shot example retrieval (multilingual embedding model)
EMBED_MODEL=qwen3-embedding:0.6b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=
# Empty = SDK default (v1). Preview models such as gemini-3-flash-preview need v1beta
GEMINI_API_VERSION=
COHERE_API_KEY=
COHERE_MODEL=

# --- Gateway (phase 4) ---
JWT_SECRET=change-me-dev-only
API_PORT=8200
WEB_PORT=5180

# --- Other LLM endpoints (section 7.3 of the handbook) ---
# OpenAI-compatible server that needs a key (vLLM, an in-region gateway); Ollama ignores it
OLLAMA_API_KEY=
# Embeddings for example retrieval: default = OLLAMA_BASE_URL. Empty EMBED_MODEL = word overlap
EMBED_BASE_URL=
EMBED_API_KEY=

# --- Real OBDX admin API (empty URL = in-process mock) ---
OBDX_ADMIN_URL=
OBDX_API_TOKEN=
OBDX_CA_BUNDLE=
OBDX_TIMEOUT_S=10

# --- Safety: set false on any real or shared database (seeding drops core, obdx, atum) ---
SEED_ALLOWED=true
